{
  "model_type": "llama",
  "architectures": [
    "LlamaForCausalLM"
  ],
  "vocab_size": 8192,
  "hidden_size": 384,
  "intermediate_size": 1024,
  "num_hidden_layers": 12,
  "num_attention_heads": 6,
  "num_key_value_heads": 2,
  "max_position_embeddings": 512,
  "rope_theta": 10000.0,
  "rms_norm_eps": 1e-06,
  "hidden_act": "silu",
  "attention_bias": false,
  "mlp_bias": false,
  "attention_dropout": 0.0,
  "tie_word_embeddings": true,
  "initializer_range": 0.02,
  "use_cache": false
}
